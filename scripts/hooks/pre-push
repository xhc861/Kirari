#!/bin/sh
#
# 拦住「站点内容被推到 main」。
#
# main 是给别人 fork 用的干净模板，src/content/posts/ 与 src/content/scores/
# 都应当永远只有 .gitkeep。
# scripts/new-post.js 拦的是「在 main 上建文章」，但拦不住这些情况：
#
#   - 在 content 上写好文章，手滑 git push origin content:main
#   - 从别处 cherry-pick 时把内容一起带到了 main
#   - 早先误提交的内容一直躺在 main 的历史里，某次推送才连带上去
#
# 所以这里不看「你人在哪个分支」，只看「即将落到远端 main 的那棵树里有没有内容」。
# 不管它是怎么进去的，都拦得住。
#
# 新增内容集合时记得把目录加进 CONTENT_DIRS —— 漏加等于这类内容没有防线。
#
# 安装：git config core.hooksPath scripts/hooks
#       （pnpm install 会通过 package.json 的 prepare 脚本自动设置）
#
# 确实要推带文章的 main（基本不会发生）：git push --no-verify

# 受保护的内容目录。新增内容集合时加在这里
CONTENT_DIRS="src/content/posts src/content/scores"

# 40 个 0，Git 用它表示「这个 ref 不存在」（即删除分支）
ZERO="0000000000000000000000000000000000000000"

status=0

# stdin 每行是：<本地 ref> <本地 oid> <远端 ref> <远端 oid>
while read -r local_ref local_oid remote_ref remote_oid; do
	# 只管推到 main 的，推 content 不受影响
	[ "$remote_ref" = "refs/heads/main" ] || continue

	# 删除分支没有树可查，跳过
	[ "$local_oid" = "$ZERO" ] && continue

	# 各目录下除 .gitkeep 以外的一切都算内容
	found=$(git ls-tree -r --name-only "$local_oid" -- $CONTENT_DIRS 2>/dev/null |
		grep -v '/\.gitkeep$')

	[ -z "$found" ] && continue

	status=1
	echo "" >&2
	echo "推送被拦下：这次推到 main 的树里有站点内容。" >&2
	echo "" >&2
	echo "  本地 ref：$local_ref" >&2
	echo "$found" | sed 's/^/    /' >&2
	echo "" >&2
	echo "main 是不含内容的干净模板，文章与谱曲只属于 content 分支。" >&2
	echo "" >&2
	echo "如果是推错了分支，改推 content：" >&2
	echo "" >&2
	echo "    git push origin content" >&2
	echo "" >&2
	echo "如果内容确实被提交进了 main，先把它从 main 移除：" >&2
	echo "" >&2
	echo "    git checkout main" >&2
	echo "    git rm <上面列出的路径>" >&2
	echo "    git commit -m \"chore: 从 main 移除内容\"" >&2
	echo "" >&2
	echo "详见 README 的「分支与发布流程」。" >&2
	echo "" >&2
done

exit $status
