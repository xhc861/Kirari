---
/**
 * 相关文章。按标签重合度与分类挑选，给读者一条按内容延伸的路径 ——
 * 纯时间顺序的「上一篇/下一篇」经常跳到毫不相干的主题。
 */
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;
---

{posts.length > 0 && (
<div class="related card-base px-6 md:px-9 py-6 mb-4">
    <h2 class="related-title">看完这篇，也许还想看</h2>

    <div class="related-grid">
        {posts.map((p) => (
            <a href={getPostUrlBySlug(p.id)} class="related-card">
                <div class="related-card-title">{p.data.title}</div>
                {p.data.description && (
                    <div class="related-card-desc">{p.data.description}</div>
                )}
                <div class="related-card-meta">
                    <time datetime={formatDateToYYYYMMDD(p.data.published)}>
                        {formatDateToYYYYMMDD(p.data.published)}
                    </time>
                    {p.data.tags.length > 0 && (
                        <span class="related-card-tag">{p.data.tags[0]}</span>
                    )}
                </div>
            </a>
        ))}
    </div>
</div>
)}

<style>
    @reference "../styles/theme.css";

    .related-title {
        @apply text-lg font-bold text-90 mb-4;
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.75rem;
    }

    .related-card {
        @apply flex flex-col gap-1.5 p-4 rounded-xl transition;
        background: var(--btn-regular-bg);
        /* 悬停时轻微抬起：让卡片对指针有反应，而不是一动不动 */
        transition: transform 0.22s ease, background 0.22s ease;
    }
    .related-card:hover {
        background: var(--btn-regular-bg-hover);
        transform: translateY(-3px);
    }
    .related-card:active {
        transform: translateY(-1px);
    }

    .related-card-title {
        @apply font-semibold text-90 leading-snug;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .related-card-desc {
        @apply text-sm text-50 leading-snug;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .related-card-meta {
        @apply flex items-center gap-2 text-xs text-30 mt-auto pt-1;
        font-variant-numeric: tabular-nums;
    }
    .related-card-tag {
        @apply px-1.5 py-0.5 rounded;
        background: var(--card-bg);
        color: var(--primary);
    }

    @media (prefers-reduced-motion: reduce) {
        .related-card:hover, .related-card:active { transform: none; }
    }
</style>
