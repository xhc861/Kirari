---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed absolute transition-all fixed right-4 px-2 py-2"]}>
    {links.map((link) => (
        <div class="navbar-link-mobile" data-link-url={link.url}>
            <a href={link.external ? link.url : url(link.url)} class="group flex justify-between items-center py-2 pl-3 pr-1 rounded-lg gap-8
                hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition
            "
               target={link.external ? "_blank" : null}
            >
                <div class="transition text-black/75 dark:text-white/75 font-bold group-hover:text-[var(--primary)] group-active:text-[var(--primary)]">
                    {link.name}
                </div>
                {!link.external && <Icon name="material-symbols:chevron-right-rounded"
                      class="transition text-[1.25rem] text-[var(--primary)]"
                >
                </Icon>}
                {link.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                      class="transition text-[0.75rem] text-black/25 dark:text-white/25 -translate-x-1"
                >
                </Icon>}
            </a>

            {/*
              移动端不做悬停下拉，二级项直接缩进平铺列出来 —— 触屏上多一层
              展开手势只会更难点中，而这里总共就两项。
            */}
            {link.children?.map((child) => (
                <a href={child.external ? child.url : url(child.url)} class="group flex justify-between items-center py-1.5 pl-7 pr-1 rounded-lg gap-8
                    hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition
                "
                   target={child.external ? "_blank" : null}
                >
                    <div class="transition text-black/60 dark:text-white/60 text-sm font-medium group-hover:text-[var(--primary)] group-active:text-[var(--primary)]">
                        {child.name}
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded"
                          class="transition text-[1rem] text-[var(--primary)]/60"
                    >
                    </Icon>
                </a>
            ))}
        </div>
    ))}
</div>

<script>
import { NAV_KEY_FALLBACKS } from '../../utils/navbar-utils';

function applyNavbarSettingsMobile() {
    const saved = localStorage.getItem('effectsSettings');
    if (saved) {
        try {
            const settings = JSON.parse(saved);
            if (settings.navbarLinks) {
                const links = document.querySelectorAll('.navbar-link-mobile');
                links.forEach(link => {
const raw = link.getAttribute('data-link-url') || '';
/*
 * 只处理内部链接，外部链接（如 GitHub）不受设置控制。
 * 判断依据从「元素上有没有 target」改成看 URL 本身 —— 现在带下拉的项
 * 外层是个 div，target 挂在里面的 <a> 上，靠属性判断会漏。
 */
if (raw && !/^https?:\/\//.test(raw)) {
    /*
     * 用链接自带的 data-link-url 派生键来匹配，而不是拿 URL 猜关键词。
     * 之前是一串 if (url.includes('archive')) 的硬编码，每加一个导航项
     * 就要同步改这里，漏一处就失效 —— 加「统计」时就漏过。
     */
    const key = raw.replace(/^\/+|\/+$/g, '').split('/')[0] || 'home';
    const fallbackKey = NAV_KEY_FALLBACKS[key];
    const visible = settings.navbarLinks[key]
        ?? (fallbackKey ? settings.navbarLinks[fallbackKey] : undefined)
        ?? true;
    (link as HTMLElement).style.display = visible ? '' : 'none';
}
});
            }
        } catch (e) {
            console.error('Failed to apply navbar settings (mobile):', e);
        }
    }
}

// 应用设置
applyNavbarSettingsMobile();

// 监听设置变化
window.addEventListener('effectsSettingsChanged', applyNavbarSettingsMobile);
</script>
