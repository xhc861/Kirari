---
/**
 * 语言切换。
 *
 * 在当前路径上增删语言前缀后跳转 —— 停在同一个页面，而不是把人踢回首页。
 *
 * 刻意不做「按浏览器语言自动跳转」：那样中文读者点开别人分享的英文链接会被
 * 弹走，反之亦然，分享出去的地址等于失效。语言由读者自己选。
 */
import {
	getLangFromUrl,
	LOCALE_LABEL,
	LOCALES,
	withLangPrefix,
} from "@i18n/utils";
import { url } from "@utils/url-utils";

const current = getLangFromUrl(Astro.url);
const others = LOCALES.filter((l) => l !== current);
---

<div class="lang-switch">
    {others.map((locale) => (
        <a
            href={url(withLangPrefix(Astro.url.pathname, locale))}
            class="lang-link btn-plain scale-animation rounded-lg h-11 px-4 font-bold"
            hreflang={locale === "zh_CN" ? "zh-CN" : locale}
            aria-label={`Switch to ${LOCALE_LABEL[locale]}`}
        >
            <span class="lang-globe" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M2 12h20"></path>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
            </span>
            {LOCALE_LABEL[locale]}
        </a>
    ))}
</div>

<style>
    .lang-switch {
        display: flex;
        align-items: center;
    }

    .lang-link {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

    .lang-globe {
        display: flex;
        align-items: center;
        /* 地球图标随悬停轻轻转一下，给切换动作一点回应 */
        transition: transform 0.4s ease;
    }
    .lang-link:hover .lang-globe {
        transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .lang-globe { transition: none; }
        .lang-link:hover .lang-globe { transform: none; }
    }
</style>
