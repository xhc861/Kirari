---
/**
 * 文章页（英文，/en/ 前缀）。
 *
 * 每篇中文文章都会有一条 /en/ 路由 —— 有译文就用译文，没有就回落到原文
 * 并在顶部说明。这样英文读者点进来不会撞 404，链接也不会因为「还没翻」而失效。
 *
 * 单独成文件是因为 Astro 一条路由只允许一个 rest 参数，
 * [...lang]/posts/[...slug] 是非法的。
 */
import PostDetail from "@components/pages/PostDetail.astro";
import { getSortedPosts, getTranslatedPost } from "@utils/content-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return Promise.all(
		blogEntries.map(async (entry) => {
			const translated = await getTranslatedPost(entry.id);
			return {
				// slug 用原文的 id，两种语言共用同一套 URL 尾部
				params: { slug: entry.id },
				props: {
					entry: translated ?? entry,
					fallback: !translated,
				},
			};
		}),
	);
}

const { entry, fallback } = Astro.props;
---
<PostDetail entry={entry} locale="en" fallback={fallback} />
