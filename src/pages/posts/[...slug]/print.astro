---
/**
 * 文章的打印版。
 *
 * 走同一套 markdown 管线（remark/rehype 插件、KaTeX、代码高亮、VLOOK 语法
 * 全都在），但套的是 PrintLayout —— 没有导航栏、侧栏、绝对定位、入场动画。
 *
 * 之前直接打印正文页反复出现内容截断，根因是主布局的 absolute + overflow
 * 结构；这里从根上避开，而不是靠一层层 !important 去掰回来。
 */
import { render } from "astro:content";
import PrintLayout from "@layouts/PrintLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { profileConfig, siteConfig } from "../../../config";

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const canonical = new URL(
	`/posts/${entry.id}/`,
	Astro.site ?? Astro.url,
).href;
---

<PrintLayout title={entry.data.title} description={entry.data.description}>
    <!-- 屏幕上给个导出按钮，打印时自动隐藏 -->
    <div class="print-bar">
        <button type="button" id="do-print">导出 PDF</button>
        <span>浏览器打印对话框里选「另存为 PDF」即可</span>
        <a href={`/posts/${entry.id}/`}>← 回到文章</a>
    </div>

    <header class="doc-header">
        <h1 class="doc-title">{entry.data.title}</h1>
        <div class="doc-meta">
            <span>{profileConfig.name}</span>
            <span>{formatDateToYYYYMMDD(entry.data.published)}</span>
            {entry.data.category && <span>{entry.data.category}</span>}
            {remarkPluginFrontmatter.words && <span>{remarkPluginFrontmatter.words} 字</span>}
        </div>
        {entry.data.summary && (
            <div class="doc-summary">{entry.data.summary}</div>
        )}
    </header>

    <article class="doc-body custom-md">
        <Content />
    </article>

    <footer class="doc-footer">
        <div>{siteConfig.title} · {canonical}</div>
        <div>导出自 {formatDateToYYYYMMDD(new Date())}</div>
    </footer>

    <script is:inline>
      document.getElementById("do-print")?.addEventListener("click", () => {
        window.print();
      });
    </script>
</PrintLayout>
