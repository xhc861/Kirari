---
/**
 * 谱曲详情。
 *
 * 不复用文章的 PostDetail：那套带着目录、系列串联、上一篇/下一篇、评论区，
 * 对一首曲子来说全是噪音。这里只要「听 / 下载谱子 / 读创作手记」三件事。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";
import { getSortedScores } from "@utils/content-utils";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { url } from "@utils/url-utils";
import { render } from "astro:content";

export async function getStaticPaths() {
	const scores = await getSortedScores();
	return scores.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<MainGridLayout title={d.title} description={d.description}>
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <a href={url("/works/scores/")} class="score-back">
            <Icon name="material-symbols:chevron-left-rounded" class="text-[1.1rem]" />
            谱曲
        </a>

        <h1 class="text-2xl md:text-3xl font-bold text-90 mt-2 mb-3">{d.title}</h1>

        <div class="score-facts">
            <span>{formatDateToYYYYMMDD(d.published)}</span>
            {d.instrument && <span class="score-tag">{d.instrument}</span>}
            {d.duration && <span>{d.duration}</span>}
        </div>

        {d.description && <p class="text-75 text-sm mt-3">{d.description}</p>}

        {(d.audio || d.sheet) && (
            <div class="score-actions">
                {/*
                  原生 <audio> 而不是站点的音乐播放器：那个播放器是全站常驻的
                  播放列表，把作品塞进去会打断用户正在听的东西。
                */}
                {d.audio && <audio controls preload="none" src={d.audio} class="score-audio"></audio>}
                {d.sheet && (
                    <a href={d.sheet} class="btn-regular rounded-lg px-4 py-2 text-sm font-medium flex items-center gap-1.5"
                       target="_blank" rel="noopener">
                        <Icon name="material-symbols:download-rounded" class="text-[1.05rem]" />
                        乐谱
                    </a>
                )}
            </div>
        )}
    </div>

    <div class="card-base px-6 md:px-9 py-6 onload-animation">
        <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
        </Markdown>
    </div>
</MainGridLayout>

<style>
    .score-back {
        display: inline-flex;
        align-items: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--primary);
    }

    .score-facts {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        font-size: 0.85rem;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
    }
    .score-tag {
        padding: 0.1rem 0.5rem;
        border-radius: 9999px;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        opacity: 1;
    }

    .score-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.1rem;
    }
    .score-audio {
        height: 2.5rem;
        max-width: 100%;
        flex: 1 1 18rem;
        min-width: 0;
    }
</style>
