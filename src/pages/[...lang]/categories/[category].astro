---
/**
 * 分类页（静态路由）。理由同标签页，见 tags/[tag].astro。
 *
 * 未分类文章不生成独立页面 —— 它不是一个真实分类，仍由归档页的筛选处理。
 */
import PostList from "@components/PostList.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { DEFAULT_LOCALE, LOCALES } from "../../../i18n/utils";

export async function getStaticPaths() {
	const posts = await getSortedPosts();

	const names = new Set<string>();
	for (const p of posts) {
		const c = typeof p.data.category === "string" ? p.data.category.trim() : "";
		if (c) names.add(c);
	}

	// 语言 × 分类：两个维度都要展开，默认语言的 lang 传 undefined 以匹配根路径
	return LOCALES.flatMap((locale) =>
		[...names].map((category) => ({
			params: {
				lang: locale === DEFAULT_LOCALE ? undefined : locale,
				category,
			},
			props: {
				locale,
				category,
				posts: posts.filter(
					(p) =>
						typeof p.data.category === "string" &&
						p.data.category.trim() === category,
				),
			},
		})),
	);
}

const { locale, category, posts } = Astro.props;
---

<MainGridLayout lang={locale} title={`分类：${category}`} description={`「${category}」分类下的全部文章`}>
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <div class="text-50 text-sm mb-1">分类</div>
        <h1 class="text-2xl md:text-3xl font-bold text-90">
            {category}
            <span class="text-50 text-base font-normal ml-2">{posts.length} 篇</span>
        </h1>
    </div>

    <PostList posts={posts} emptyTitle={`「${category}」下还没有文章`} />
</MainGridLayout>
