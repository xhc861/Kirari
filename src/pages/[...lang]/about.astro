---
/**
 * 关于页。
 *
 * 放在 [...lang] 下：Astro 的 rest 参数可以匹配空值，所以同一个文件既产出
 * /about/（中文，无前缀）也产出 /en/about/（英文），不必每种语言各写一份。
 */
import Markdown from "@components/misc/Markdown.astro";
import { getEntry, render } from "astro:content";
import I18nKey from "../../i18n/i18nKey";
import { DEFAULT_LOCALE, LOCALES, useTranslations } from "../../i18n/utils";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

export function getStaticPaths() {
	return LOCALES.map((locale) => ({
		// 默认语言不带前缀：lang 传 undefined 即匹配根路径
		params: { lang: locale === DEFAULT_LOCALE ? undefined : locale },
		props: { locale },
	}));
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// 英文版内容放在 spec/en/about.md，缺失时回落到中文原文
// （用目录而非 about.en.md：glob loader 生成 id 时会处理掉文件名里的点号）
const translated =
	locale !== DEFAULT_LOCALE ? await getEntry("spec", "en/about") : undefined;
const entry = translated ?? (await getEntry("spec", "about"));

if (!entry) {
	throw new Error("About page content not found");
}

const missingTranslation = locale !== DEFAULT_LOCALE && !translated;

const { Content } = await render(entry);
---
<MainGridLayout lang={locale} title={t(I18nKey.about)} description={t(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            {missingTranslation && (
                <div class="fallback-note">
                    This page hasn’t been translated yet — showing the original Chinese version.
                </div>
            )}
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>

<style>
    @reference "../../styles/theme.css";

    /* 缺译文时说明情况，而不是给一个 404 或一片空白 */
    .fallback-note {
        @apply text-sm mb-4 px-3 py-2 rounded-md;
        background: color-mix(in oklab, var(--primary) 10%, transparent);
        color: var(--primary);
    }
</style>
