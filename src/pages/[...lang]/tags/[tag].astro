---
/**
 * 标签页（静态路由）。
 *
 * 原先标签只是 /archive/?tag=xxx 的查询参数，靠前端过滤 —— 搜索引擎抓不到、
 * 也进不了 sitemap，等于每个标签都没有自己的页面。改成真实路由后可被索引、
 * 可直接分享；归档页的交互式筛选保留不变。
 */
import PostList from "@components/PostList.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "@utils/content-utils";
import { DEFAULT_LOCALE, LOCALES } from "../../../i18n/utils";

export async function getStaticPaths() {
	const tags = await getTagList();
	const posts = await getSortedPosts();

	// 语言 × 标签：两个维度都要展开，默认语言的 lang 传 undefined 以匹配根路径
	return LOCALES.flatMap((locale) =>
		tags.map((tag) => ({
			params: {
				lang: locale === DEFAULT_LOCALE ? undefined : locale,
				tag: tag.name,
			},
			props: {
				locale,
				tag: tag.name,
				posts: posts.filter((p) => p.data.tags.includes(tag.name)),
			},
		})),
	);
}

const { locale, tag, posts } = Astro.props;
---

<MainGridLayout lang={locale} title={`标签：${tag}`} description={`标记为「${tag}」的全部文章`}>
    <div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
        <div class="text-50 text-sm mb-1">标签</div>
        <h1 class="text-2xl md:text-3xl font-bold text-90">
            {tag}
            <span class="text-50 text-base font-normal ml-2">{posts.length} 篇</span>
        </h1>
    </div>

    <PostList posts={posts} emptyTitle={`还没有标记为「${tag}」的文章`} />
</MainGridLayout>
