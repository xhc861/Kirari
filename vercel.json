{
  "redirects": [
    { "source": "/archive", "destination": "/works/posts/", "permanent": true },
    { "source": "/archive/", "destination": "/works/posts/", "permanent": true },
    { "source": "/stats", "destination": "/dashboard/#stats", "permanent": true },
    { "source": "/stats/", "destination": "/dashboard/#stats", "permanent": true },
    { "source": "/gallery", "destination": "/dashboard/", "permanent": true },
    { "source": "/gallery/", "destination": "/dashboard/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
